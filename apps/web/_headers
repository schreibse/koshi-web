/*
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

# Content-hashed by the Angular build, so a changed file always has a new name.
/:locale/main-*
  Cache-Control: public, max-age=31536000, immutable
/:locale/chunk-*
  Cache-Control: public, max-age=31536000, immutable
/:locale/polyfills-*
  Cache-Control: public, max-age=31536000, immutable
/:locale/styles-*
  Cache-Control: public, max-age=31536000, immutable
/:locale/media/*
  Cache-Control: public, max-age=31536000, immutable
