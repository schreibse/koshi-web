{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "ks",
  "sourceRoot": "apps/web/src",
  "i18n": {
    "sourceLocale": {
      "code": "es",
      "subPath": "es"
    },
    "locales": {
      "en": {
        "translation": "apps/web/src/locale/messages.en.xlf",
        "subPath": "en"
      }
    }
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-app"],
      "outputs": ["{workspaceRoot}/dist/apps/web"],
      "options": {
        "commands": [
          "for l in es en; do d=dist/apps/web/browser/$l; if [ -f $d/404/index.html ]; then mv $d/404/index.html $d/404.html && rmdir $d/404; fi; done",
          "{ echo '<?xml version=\"1.0\" encoding=\"UTF-8\"?>'; echo '<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">'; grep -rhoP '<link rel=\"canonical\" href=\"\\K[^\"]+' dist/apps/web/browser --include=index.html | sort -u | sed 's|.*|  <url><loc>&</loc></url>|'; echo '</urlset>'; } > dist/apps/web/browser/sitemap-paginas.xml",
          "{ echo '<?xml version=\"1.0\" encoding=\"UTF-8\"?>'; echo '<sitemapindex xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">'; for s in sitemap-paginas.xml blog/sitemap; do echo \"  <sitemap><loc>https://koshisoftware.pe/$s</loc></sitemap>\"; done; echo '</sitemapindex>'; } > dist/apps/web/browser/sitemap.xml",
          "cp apps/web/robots.txt dist/apps/web/browser/robots.txt",
          "cp apps/web/_headers dist/apps/web/browser/_headers",
          "cp apps/web/public/favicon.ico apps/web/public/favicon.svg apps/web/public/apple-touch-icon.png dist/apps/web/browser/"
        ],
        "parallel": false
      }
    },
    "build-app": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/web",
        "browser": "apps/web/src/main.ts",
        "tsConfig": "apps/web/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/web/public"
          }
        ],
        "styles": [
          "@fontsource-variable/geist/index.css",
          "@fontsource-variable/geist-mono/index.css",
          "apps/web/src/styles.css",
          "apps/web/src/styles.scss"
        ],
        "server": "apps/web/src/main.server.ts",
        "outputMode": "server",
        "ssr": {
          "entry": "apps/web/src/server.ts",
          "platform": "neutral"
        },
        "security": {
          "allowedHosts": [
            "koshisoftware.pe",
            "*.koshisoftware.workers.dev",
            "localhost"
          ]
        },
        "subresourceIntegrity": true,
        "localize": true,
        "polyfills": ["@angular/localize/init"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "localize": ["es"]
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "web:build-app:production"
        },
        "development": {
          "buildTarget": "web:build-app:development"
        }
      }
    },
    "stylelint": {
      "executor": "nx-stylelint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/web/**/*.css", "apps/web/**/*.scss"]
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "web:build-app",
        "format": "xlf2",
        "outputPath": "apps/web/src/locale"
      }
    }
  }
}
