{
  "name": "worker",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "worker",
  "projectType": "application",
  "targets": {
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "dependsOn": ["web:build"],
      "options": {
        "commands": [
          "wrangler d1 migrations apply koshi-blog --local --persist-to dist/.wrangler-e2e",
          "wrangler dev --port 4890 --persist-to dist/.wrangler-e2e"
        ],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "wrangler types worker/worker-configuration.d.ts --env-file .dev.vars.example",
          "tsc --noEmit -p worker/tsconfig.json"
        ],
        "parallel": false
      }
    }
  }
}
