{
  "name": "worker",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "worker",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["web", "admin"],
          "target": "build"
        }
      ],
      "outputs": ["{workspaceRoot}/dist/site"],
      "options": {
        "commands": [
          "rm -rf dist/site && cp -r dist/apps/web/browser dist/site && cp -r dist/apps/admin/browser dist/site/admin"
        ]
      }
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "rm -rf dist/.wrangler-e2e",
          "wrangler d1 migrations apply koshi-blog --local --persist-to dist/.wrangler-e2e",
          "wrangler dev --port 4890 --persist-to dist/.wrangler-e2e --env-file worker/e2e.env"
        ],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "wrangler types worker/worker-configuration.d.ts --env-file .dev.vars.example",
          "tsc --noEmit -p worker/tsconfig.json"
        ],
        "parallel": false
      }
    }
  }
}
